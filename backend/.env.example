DATABASE_URL=postgresql+psycopg://recicla:recicla@db:5432/recicla
# Obligatorio: la API no arranca sin un valor propio de al menos 16 caracteres.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
